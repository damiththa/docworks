# DocWorks Suite (ScrubDoc & DiffDoc) — PROD Cloud Run Environment Template
# Zero secrets are ever committed to Git or stored on local developer machines.
# Secret values live in GCP Secret Manager (`docworks-514722`) and are mounted into Cloud Run via `--set-secrets`.

APP_ID="scrubdoc"                 # scrubdoc | diffdoc
STORAGE_PROVIDER="box"            # box | dropbox | gdrive
GCP_PROJECT_ID="docworks-514722"
USE_FIRESTORE="true"
FIRESTORE_COLLECTION="entitlements_box"
SUPPORT_EMAIL=""

# Monthly Free-tier quotas (overridden at deploy time if desired)
FREE_SCRUB_LIMIT="25"
FREE_DIFF_LIMIT="5"
FREE_RADAR_FIX_LIMIT="25"

# Mounted via Cloud Run `--set-secrets`:
#   PROVIDER_CLIENT_ID=BOX_SCRUBDOC_CLIENT_ID:latest       (or BOX_DIFFDOC_CLIENT_ID:latest)
#   PROVIDER_CLIENT_SECRET=BOX_SCRUBDOC_CLIENT_SECRET:latest (or BOX_DIFFDOC_CLIENT_SECRET:latest)
#   HMAC_PEPPER=HMAC_PEPPER_BOX:latest
