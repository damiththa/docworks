  "cards": [
    {
      "dot": "cyan",
      "title": "Shared Suite Shell & Focused App Runtimes",
      "items": [
        "shared/frontend/ (suite_shell.js, suite-shell.css, shareradar_engine.js) powers both ScrubDoc and DiffDoc identically.",
        "Each app ships an independent FastAPI entrypoint (create_docworks_app) and minimal vendored Docker image.",
        "All PDF parsing, OCR, EXIF scrubbing, pixel redaction, contract diffing, and XLSX formula audits stay 100% in browser RAM."
      ]
    },
    {
      "dot": "emerald",
      "title": "Provider Isolation (Box Active; Dropbox & GDrive Ready)",
      "items": [
        "Provider contracts isolate inside shared/backend/providers.py (Python ProviderSpec) and shared/providers/<provider>/client.js.",
        "Box Web Integrations launch ScrubDoc and DiffDoc with parent-folder OAuth scoping and direct CORS 302 streams.",
        "Dropbox and Google Drive scaffolds pre-register adapter modules behind implemented=False until marketplace activation."
      ]
    },
    {
      "dot": "amber",
      "title": "Single-Project GCP DEV+PROD (docworks-514722)",
      "items": [
        "Keyless GitHub WIF auto-deploys dev branches (scrubdoc-box-dev, diffdoc-box-dev) while PROD requires owner gate (prod.auto_deploy_on_push=false).",
        "Separate docworks-dev-runner and docworks-prod-runner SAs isolate *_DEV Secret Manager keys and Firestore entitlements_{prov}[_dev].",
        "Unified cross-app entitlements link ScrubDoc, DiffDoc, and ShareRadar Pro via plan_bundle / app Pro plans under opaque HMAC user keys."
      ]
    }
  ]
